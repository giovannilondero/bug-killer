{
  "name": "bug-killer",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "node --test test/*.test.ts",
    "check": "pnpm typecheck && pnpm lint && node --test test/*.test.ts",
    "lint": "oxlint src test && ritmo-devtools lint src/sim/lint.ts",
    "serve": "node src/server/main.ts",
    "serve:cloudflare": "pnpm build && wrangler dev"
  },
  "dependencies": {
    "@typeonce/ritmo": "^0.14.0",
    "@typeonce/ritmo-browser": "^0.14.0",
    "@typeonce/ritmo-math": "^0.14.0",
    "pixi.js": "8.22.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "@typeonce/oxlint-plugin-ritmo": "0.14.0",
    "@typeonce/ritmo-devtools": "0.14.0",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "oxlint": "^1.89.0",
    "playwright-core": "1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0"
  }
}
